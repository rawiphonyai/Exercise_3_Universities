public class University implements Comparable<University> {  
    private String name, initials; 
    private int foundedYear, students, fulltimeTeachers;

    public University(String name, String initials, int foundedYears, int students, int fulltimeTeachers){
        this.name = name;
        this.initials = initials;
        this.foundedYear = foundedYears;
        this.students = students;
        this.fulltimeTeachers = fulltimeTeachers;
    }

    public University(String initials ){
        this.initials = initials;
    }

    @Override 
    public int compareTo(University other)  { 
        if(this.students != other.students){
            return other.students - this.students;
        }
        if(this.fulltimeTeachers != other.fulltimeTeachers){
            return other.fulltimeTeachers - this.fulltimeTeachers;
        }
        return this.name.compareToIgnoreCase(other.name);
     }    // change code (see 2.2)  

    @Override 
    public boolean equals(Object param)     {
        if(param instanceof University){
            University other = (University) param;
            return this.initials.equalsIgnoreCase(other.initials);
        }
        return false;
    }  // change code (see 2.4)
}  

    public String getName() {return name;}
    public String getInitials() {return initials}
    public int getFoundYears() {return foundedYear;}
    public int getStudents() {return students;}
    public int getFulltimeTeachers() {return fulltimeTeachers;}

